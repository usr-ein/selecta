{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "vcpkg-static",
      "hidden": true,
      "description": "Static dependencies from vcpkg (ADR-004). Needs VCPKG_ROOT.",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx-selecta",
        "VCPKG_HOST_TRIPLET": "arm64-osx-selecta",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-ports",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.4",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug",
      "description": "Debug with line tables only (-g1): file:line backtraces, builds about half the size.",
      "inherits": [ "base", "vcpkg-static" ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-g1",
        "CMAKE_CXX_FLAGS_DEBUG": "-g1",
        "CMAKE_OBJCXX_FLAGS_DEBUG": "-g1"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug with AddressSanitizer and UBSan",
      "inherits": "dev",
      "cacheVariables": { "SELECTA_SANITIZE": "address;undefined" }
    },
    {
      "name": "tsan",
      "displayName": "Debug with ThreadSanitizer",
      "inherits": "dev",
      "cacheVariables": { "SELECTA_SANITIZE": "thread" }
    },
    {
      "name": "lint",
      "displayName": "Debug with clang-tidy on every translation unit",
      "inherits": "dev",
      "cacheVariables": { "SELECTA_CLANG_TIDY": "ON" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": [ "base", "vcpkg-static" ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SELECTA_BUILD_TESTS": "OFF",
        "SELECTA_DEVTOOLS": "OFF"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (dependencies from the environment)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "lint", "configurePreset": "lint" },
    { "name": "release", "configurePreset": "release" },
    { "name": "ci", "configurePreset": "ci" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "environment": { "QT_QPA_PLATFORM": "minimal" }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan" },
    { "name": "ci", "inherits": "base", "configurePreset": "ci" }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "ci",
      "steps": [
        { "type": "configure", "name": "ci" },
        { "type": "build", "name": "ci" },
        { "type": "test", "name": "ci" }
      ]
    }
  ]
}
