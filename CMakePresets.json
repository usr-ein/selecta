{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON", "CMAKE_CXX_SCAN_FOR_MODULES": "OFF" }
    },
    {
      "name": "vcpkg-static",
      "hidden": true,
      "description": "Static dependencies from vcpkg (ADR-004). Needs VCPKG_ROOT.",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx-selecta",
        "VCPKG_HOST_TRIPLET": "arm64-osx-selecta",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-ports",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.4",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "vcpkg-static-linux",
      "hidden": true,
      "description": "Static dependencies from vcpkg on Linux (NFR-1, ADR-004). Needs VCPKG_ROOT.",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-selecta",
        "VCPKG_HOST_TRIPLET": "x64-linux-selecta",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-ports"
      }
    },
    {
      "name": "vcpkg-static-windows",
      "hidden": true,
      "description": "Static dependencies from vcpkg on Windows with MSVC (NFR-1, ADR-004). Needs VCPKG_ROOT and a Visual Studio developer environment.",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-selecta",
        "VCPKG_HOST_TRIPLET": "x64-windows-selecta",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-ports",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug",
      "description": "Debug with line tables only (-g1): file:line backtraces, builds about half the size.",
      "inherits": [ "base", "vcpkg-static" ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-g1",
        "CMAKE_CXX_FLAGS_DEBUG": "-g1",
        "CMAKE_OBJCXX_FLAGS_DEBUG": "-g1"
      }
    },
    {
      "name": "linux",
      "displayName": "Debug on Linux",
      "description": "Debug with Clang and line tables only (-g1), as dev. Dependencies keep the system's default compiler.",
      "inherits": [ "base", "vcpkg-static-linux" ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_FLAGS_DEBUG": "-g1",
        "CMAKE_CXX_FLAGS_DEBUG": "-g1"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Debug on Linux with AddressSanitizer and UBSan",
      "inherits": "linux",
      "cacheVariables": { "SELECTA_SANITIZE": "address;undefined" }
    },
    {
      "name": "windows",
      "displayName": "RelWithDebInfo on Windows (MSVC)",
      "description": "Debug information in the object files (/Z7): no shared PDB for parallel compiles to wait on.",
      "inherits": [ "base", "vcpkg-static-windows" ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug with AddressSanitizer and UBSan",
      "inherits": "dev",
      "cacheVariables": { "SELECTA_SANITIZE": "address;undefined" }
    },
    {
      "name": "tsan",
      "displayName": "Debug with ThreadSanitizer",
      "inherits": "dev",
      "cacheVariables": { "SELECTA_SANITIZE": "thread" }
    },
    {
      "name": "lint",
      "displayName": "Debug with clang-tidy on every translation unit",
      "inherits": "dev",
      "cacheVariables": { "SELECTA_CLANG_TIDY": "ON" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": [ "base", "vcpkg-static" ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SELECTA_BUILD_TESTS": "OFF",
        "SELECTA_DEVTOOLS": "OFF"
      }
    },
    {
      "name": "beta",
      "displayName": "Beta",
      "description": "The maintainer's test build: optimised, line tables (-g1), the live network allowed (the user still opts in, SAFE-3), developer tools for --debug-server. Never for automated runs (CLAUDE.md).",
      "inherits": "release",
      "cacheVariables": {
        "SELECTA_ENABLE_LIVE_SERVER": "ON",
        "SELECTA_DEVTOOLS": "ON",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g1 -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g1 -DNDEBUG",
        "CMAKE_OBJCXX_FLAGS_RELWITHDEBINFO": "-O2 -g1 -DNDEBUG"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (dependencies from the environment)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "windows", "configurePreset": "windows" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "lint", "configurePreset": "lint" },
    { "name": "release", "configurePreset": "release" },
    { "name": "beta", "configurePreset": "beta" },
    { "name": "ci", "configurePreset": "ci" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "environment": { "QT_QPA_PLATFORM": "minimal" }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "linux", "inherits": "base", "configurePreset": "linux" },
    { "name": "linux-asan", "inherits": "base", "configurePreset": "linux-asan" },
    { "name": "windows", "inherits": "base", "configurePreset": "windows" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan" },
    { "name": "ci", "inherits": "base", "configurePreset": "ci" }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "ci",
      "steps": [
        { "type": "configure", "name": "ci" },
        { "type": "build", "name": "ci" },
        { "type": "test", "name": "ci" }
      ]
    }
  ]
}
