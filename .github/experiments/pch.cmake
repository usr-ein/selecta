# P-028 experiment only (CMAKE_PROJECT_INCLUDE): precompiled standard, Qt and gtest headers for each of Selecta's own
# C++ targets, to time it against plain builds. Not for merging.
function(_p028_pch dir)
    get_property(targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(type ${target} TYPE)
        get_target_property(source_dir ${target} SOURCE_DIR)
        if(NOT type MATCHES "^(STATIC_LIBRARY|EXECUTABLE|OBJECT_LIBRARY)$" OR NOT source_dir MATCHES "/(src|tests|tools)(/|$)")
            continue()
        endif()
        get_target_property(sources ${target} SOURCES)
        if(NOT sources MATCHES "\\.cpp")
            continue()
        endif()
        get_target_property(libraries ${target} LINK_LIBRARIES)
        if(NOT libraries)
            set(libraries "")
        endif()
        set(headers <algorithm> <chrono> <functional> <memory> <optional> <string> <utility> <vector>
            <QtCore/QObject> <QtCore/QString> <QtCore/QList> <QtCore/QHash> <QtCore/QByteArray> <QtCore/QDateTime>
            <QtCore/QTimer> <QtCore/QVariant>)
        if(libraries MATCHES "Qt6::Widgets|selecta_app")
            list(APPEND headers <QtWidgets/QWidget> <QtWidgets/QLabel> <QtWidgets/QAbstractItemView>
                <QtGui/QStandardItemModel>)
        endif()
        if(libraries MATCHES "Qt6::Network|selecta_slsk|selecta_meta|selecta_core|selecta_app")
            list(APPEND headers <QtNetwork/QTcpSocket> <QtNetwork/QNetworkReply>)
        endif()
        if(libraries MATCHES "GTest::")
            list(APPEND headers <gtest/gtest.h>)
        endif()
        target_precompile_headers(${target} PRIVATE ${headers})
    endforeach()
    get_property(subdirectories DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
    foreach(subdirectory IN LISTS subdirectories)
        _p028_pch("${subdirectory}")
    endforeach()
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _p028_pch "${CMAKE_SOURCE_DIR}")
